# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In Vercel, set the same names under Project Settings → Environment Variables.

# Supabase (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser or commit it. Used for one-click invite links;
# without it, invite emails fall back to "sign in with your email".
SUPABASE_SECRET_KEY=

# Optional: the app's own address, used only if the request's address is unknown.
# NEXT_PUBLIC_SITE_URL=https://app.workwithcapsule.com

# Local access tests only (the local Supabase database in Docker).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Email (Resend). Server only; never expose to the browser or commit it.
RESEND_API_KEY=
# "test" (default) only emails EMAIL_TEST_ALLOWLIST; "live" emails anyone.
EMAIL_MODE=test
# Comma-separated. Gmail "+" versions of these addresses are allowed too.
EMAIL_TEST_ALLOWLIST=
# Optional: defaults to "Christina from Capsule <hello@workwithcapsule.com>".
# EMAIL_FROM=

# Comma-separated emails that can use the Example data page (/dev/examples).
# Leave empty to turn it off. Remove before launch.
EXAMPLE_DATA_EMAILS=

# AI shaping (step 9). Server only; never expose to the browser or commit it.
# From console.anthropic.com → API keys. Without it, New capsule offers only "Fill in the fields".
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5 and medium effort.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# Local development and tests only: a free stand-in for Claude ("fake"). Ignored in production.
# AI_PROVIDER=fake
# SHAPING_FAKE_DELAY_MS=2500

# Optional: how long notification emails wait before sending, so Undo can cancel them
# (build-decisions.md 47). Defaults to 20000 (20 seconds).
# NOTIFY_DELAY_MS=20000

# Monitoring. Each is off until set. Not secrets except SENTRY_AUTH_TOKEN.
# Sentry (sentry.io → Project settings → Client keys): errors, browser and server.
# NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces (source map upload at build time). Server only, secret.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# PostHog (posthog.com → Project settings): analytics, session replays, feature flags.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
# Use the ingestion host for your PostHog region.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Daily clean-up of removed files (vercel.json crons). Any long random string;
# Vercel sends it with each scheduled call.
# CRON_SECRET=
