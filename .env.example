# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In Vercel, set the same names under Project Settings → Environment Variables.

# Supabase (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser or commit it. (Not used yet.)
SUPABASE_SECRET_KEY=

# Optional: the app's own address, used only if the request's address is unknown.
# NEXT_PUBLIC_SITE_URL=https://app.workwithcapsule.com

# Local access tests only (the local Supabase database in Docker).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Email (Resend). Server only; never expose to the browser or commit it.
RESEND_API_KEY=
# "test" (default) only emails EMAIL_TEST_ALLOWLIST; "live" emails anyone.
EMAIL_MODE=test
# Comma-separated. Gmail "+" versions of these addresses are allowed too.
EMAIL_TEST_ALLOWLIST=
# Optional: defaults to "Christina from Capsule <hello@workwithcapsule.com>".
# EMAIL_FROM=

# Later steps add: Claude API key and model name (step 9),
# Sentry and PostHog (monitoring).
